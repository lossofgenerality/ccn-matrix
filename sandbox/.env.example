# Copy to .env and fill in. .env is git-ignored — never commit it.

# Anyone registering on the sandbox server needs this token (you and the bot).
# Pick any long random string.
REGISTRATION_TOKEN=change-me-to-a-long-random-string

# The bot's account password (any long random string; you never type it).
BOT_USERNAME=claude
BOT_PASSWORD=change-me-too

# Your sandbox user ID(s), comma separated. Register this account in Element.
SANDBOX_INVITE=@lucval:localhost

# How the bot reaches Claude — set ONE of these, or neither for echo mode.
#   Direct: an Anthropic API key (stays on this computer, inside .env)
ANTHROPIC_API_KEY=
#   Via CCN Cloud: a proxy URL that accepts a Messages API body (key stays in Wolfram Cloud)
CONSTRUCT_PROXY_URL=

CLAUDE_MODEL=claude-sonnet-5-5
# Longest reply, in tokens
CLAUDE_MAX_TOKENS=4096

# Name the bot shows in rooms. In group rooms it answers when this first name,
# its username or its user ID is mentioned; one-to-one it answers everything.
BOT_DISPLAY_NAME=Claude (CCN sandbox · automated)
